{
  "name": "@tvpipe/party",
  "version": "0.4.1",
  "description": "Party games for tvpipe (tvpipe game play): the game's host page keeps rooms, players, reconnects and views in sync with phone browsers, over tvpipe's relay; the phone/TV client and the local API client",
  "keywords": [
    "party-game",
    "jackbox",
    "websocket",
    "airplay",
    "chromecast",
    "tvpipe",
    "browser"
  ],
  "homepage": "https://tvpipe.party/",
  "bugs": "https://github.com/mitsuhiko/tvpipe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsuhiko/tvpipe.git",
    "directory": "npm/party"
  },
  "license": "Apache-2.0",
  "author": "Armin Ronacher",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/web.ts",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node scripts/web.ts --check",
    "test": "node --test \"test/*.test.ts\"",
    "vectors": "node test/vectors.ts --bless"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
}
